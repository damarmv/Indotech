rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY:
     * This ruleset implements a "Public Content / Admin Management" model. 
     * All content-related data (Company Profiles, Service Packages, Gallery, etc.) 
     * is publicly readable to ensure a seamless experience for website visitors.
     * 
     * DATA STRUCTURE:
     * Data is organized into top-level collections. Singletons (like Company Profile 
     * or Website Settings) are stored as documents within their own collections 
     * (e.g., /companyProfiles/main).
     * 
     * KEY SECURITY DECISIONS:
     * 1. Authorization Independence: Write access is decoupled from the content 
     *    schema. We use a dedicated 'roles_admin' collection to verify administrative 
     *    privileges.
     * 2. Public Read: Get and List operations are allowed for all content to 
     *    facilitate SEO and unauthenticated browsing.
     * 3. Strict Admin Writes: Any operation that modifies data (create, update, 
     *    delete) requires the user to have a corresponding document in the 
     *    'roles_admin' collection.
     * 
     * DENORMALIZATION FOR AUTHORIZATION:
     * Because this app uses a global administrator role (DBAC), individual 
     * documents do not require denormalized 'ownerId' fields for basic security. 
     * The rule logic performs a fast existence check on the 'roles_admin' 
     * collection instead of complex document-level ownership checks.
     */

    // --- Global Helper Functions ---

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user is registered as an administrator.
     * Uses a lookup in the roles_admin collection for authorization independence.
     */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Combines admin check with a verification that the target resource exists.
     * Used for update and delete operations to ensure state integrity.
     */
    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Internal collection for Database Access Control (DBAC).
     * @path /roles_admin/{userId}
     * @allow (get) Any signed-in user can check their own admin status.
     * @deny (create, update, delete) Users cannot elevate their own privileges.
     * @principle Restricts access to sensitive authorization mapping.
     */
    match /roles_admin/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create, update, delete: if false; // Managed via Admin Console/CLI
    }

    /**
     * @description Stores general information about the business (Singleton).
     * @path /companyProfiles/{companyProfileId}
     * @allow (get, list) Anyone can read company info.
     * @allow (update) Only verified admins can modify profile data.
     * @deny (create, delete) Prevent accidental creation or removal of the singleton.
     * @principle Public Read with Admin-Only writes.
     */
    match /companyProfiles/{companyProfileId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Defines specific service packages offered by the business.
     * @path /servicePackages/{servicePackageId}
     * @allow (get, list) Anyone can view service offerings.
     * @allow (create, update, delete) Only admins can manage the service catalog.
     * @principle Role-based write access for public content.
     */
    match /servicePackages/{servicePackageId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Represents distinct unique selling propositions.
     * @path /serviceAdvantages/{serviceAdvantageId}
     * @allow (get, list) Anyone can view service advantages.
     * @allow (create, update, delete) Admin-restricted management.
     * @principle Ensures marketing content remains consistent and protected.
     */
    match /serviceAdvantages/{serviceAdvantageId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Visual evidence of past work/projects.
     * @path /galleryItems/{galleryItemId}
     * @allow (get, list) Publicly visible project gallery.
     * @allow (create, update, delete) Admins manage media and descriptions.
     * @principle Structural segregation of media metadata with role-based writes.
     */
    match /galleryItems/{galleryItemId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Customer reviews and social proof.
     * @path /testimonials/{testimonialId}
     * @allow (get, list) Anyone can read customer testimonials.
     * @allow (create, update, delete) Admins curate and manage social proof.
     * @principle Role-based write access to prevent spam or unauthorized edits.
     */
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }

    /**
     * @description Global website configurations and banner content (Singleton).
     * @path /websiteSettings/{websiteSettingId}
     * @allow (get, list) Anyone can read website configuration for UI rendering.
     * @allow (update) Admins can update Hero banners and CTAs.
     * @principle Public Read with Admin-Only writes for core UI configuration.
     */
    match /websiteSettings/{websiteSettingId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isExistingAdmin();
      allow delete: if isExistingAdmin();
    }
  }
}